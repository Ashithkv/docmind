# OpenAI API key used for the answer-generation LLM call.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which chat model to use. Any OpenAI chat-completion model works.
LLM_MODEL=gpt-4o-mini

# Embedding model, loaded locally via sentence-transformers (no API key needed).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where ChromaDB persists its data on disk.
CHROMA_DB_PATH=./chroma_data
CHROMA_COLLECTION_NAME=docmind_documents

# Chunking parameters (characters).
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Number of chunks retrieved per question.
TOP_K_RESULTS=4

# Where uploaded PDFs are temporarily stored during processing.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
